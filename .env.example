# Skills Composer — copy to .env and fill in values.
#   cp .env.example .env
# Shell exports override .env. Never commit .env (secrets).

# Required for /api/generate (server only — never sent from the browser)
ANTHROPIC_API_KEY=

# Optional — generation defaults
# Use hyphens only: claude-sonnet-4-20250514 (not @)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GENERATE_MAX_TOKENS=8192

# Setup: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
